# ==============================================================================
# Outback & Coastal Studio — Australian AI 3D Home Design Platform (.env.example)
# ==============================================================================

# --- Backend API Configuration ---
API_HOST=127.0.0.1
API_PORT=8000
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (SQLite local fallback by default; PostgreSQL in production) ---
DATABASE_URL=sqlite:///./data/aussiehome.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aussiehome

# --- Redis / Background Task Queue (In-process async worker fallback in dev) ---
REDIS_URL=

# --- Storage (Local filesystem by default; Cloudflare R2 in production) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=20
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=aussiehome-assets

# --- AI Provider (Server-side ONLY — NEVER expose to frontend!) ---
# Leave empty to run in transparent Assisted / Demo Mode with deterministic rules.
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Frontend Vite Configuration ---
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_DEFAULT_COUNTRY=AU
VITE_DEFAULT_CITY=Sydney
